# Copy this file to .env and adjust as needed:  cp .env.example .env
# .env is gitignored. NEVER commit real secrets — this repo is public.

# --- Neo4j (Part A, Step 1) ---
# The Neo4j Browser auth is neo4j / NEO4J_PASSWORD. Change the password for
# anything beyond local dev. Must be at least 8 characters.
NEO4J_PASSWORD=sovereign_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Connection string used by the Python loaders (graph/loaders/).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Part B services (stubbed in docker-compose.yml, uncomment when you reach them) ---
# RAGFLOW_PORT=9380
# DIFY_PORT=3000
# OPEN_WEBUI_PORT=8080
